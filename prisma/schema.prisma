// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model TrainSeries {
  id          Int       @id @default(autoincrement())
  name        String    // "2300" or "3500"
  description String
  imageUrl    String    // URL to the train image
  categories  Category[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  trainSeries TrainSeries @relation(fields: [trainSeriesId], references: [id])
  trainSeriesId Int
  parts       Part[]
}

model Part {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  partNumber  String
  location    String?   // Added location field as optional
  imageUrl    String?
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  Int
}
